# EMPREST.AI Frontend — variáveis de ambiente (exemplo, SEM segredos)
# Copie para .env e preencha. NUNCA commite o .env.
# No Vite, apenas variáveis com prefixo VITE_ chegam ao cliente — e são públicas.

# URL base da API (prefixo /v1)
VITE_API_BASE_URL=http://localhost:3000/v1

# Supabase — SOMENTE a chave pública (anon). A service_role nunca entra aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=chave-anon-publica

# Observabilidade
VITE_SENTRY_DSN=
